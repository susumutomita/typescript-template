{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/approach-registry.schema.json",
  "title": "Adaptive Agent Approach Registry",
  "description": "複雑な課題で独立した探索系統、証拠、正確な不足、停止と再開条件を管理する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "acceptanceCriteria",
    "approaches",
    "selectedApproachIds"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonGoals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "approaches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approach"
      }
    },
    "selectedApproachIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "completionAudit": {
      "$ref": "#/$defs/completionAudit"
    }
  },
  "$defs": {
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "hypothesis",
        "expectedEvidence",
        "evidence",
        "exactGap",
        "status",
        "blockedReason",
        "retryCondition",
        "adversarialFindings"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "expectedEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "exactGap": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": [
            "unexplored",
            "active",
            "promising",
            "blocked",
            "disproved",
            "selected"
          ]
        },
        "blockedReason": {
          "type": ["string", "null"]
        },
        "retryCondition": {
          "type": ["string", "null"]
        },
        "adversarialFindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adversarialFinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "blocked"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "blockedReason": {
                "type": "string",
                "minLength": 1
              },
              "retryCondition": {
                "type": "string",
                "minLength": 1
              },
              "exactGap": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "disproved"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "selected"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              },
              "exactGap": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "location"],
      "properties": {
        "kind": {
          "enum": [
            "code",
            "test",
            "typecheck",
            "build",
            "runtime",
            "measurement",
            "reproduction",
            "counterexample",
            "documentation",
            "external-verification"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adversarialFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "claim", "evidence", "resolution"],
      "properties": {
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": ["string", "null"]
        }
      }
    },
    "completionAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptanceCriteriaSatisfied",
        "adversarialAuditPassed",
        "enforcementPassed",
        "remainingGaps"
      ],
      "properties": {
        "acceptanceCriteriaSatisfied": {
          "type": "boolean"
        },
        "adversarialAuditPassed": {
          "type": "boolean"
        },
        "enforcementPassed": {
          "type": "boolean"
        },
        "remainingGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
