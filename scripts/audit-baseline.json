{
  "version": 1,
  "description": "install 時に発火する lifecycle script を持つ依存パッケージの承認済み snapshot (INVARIANT_DEPS_LIFECYCLE_AUDITED / ADR-0007)。実行は --ignore-scripts と trustedDependencies = [] が止めており、この baseline は攻撃面の変化を検出する。更新は bun scripts/audit-dependencies.ts --update + 目視レビュー + PR 本文への理由記載。",
  "entries": {
    "@eslint/eslintrc": ["prepare"],
    "@humanfs/core": ["prepare"],
    "@humanfs/node": ["prepare"],
    "@humanfs/types": ["prepare"],
    "@humanwhocodes/module-importer": ["prepare"],
    "@humanwhocodes/retry": ["prepare"],
    "@isaacs/balanced-match": ["prepare"],
    "@isaacs/brace-expansion": ["prepare"],
    "@textlint-ja/textlint-rule-preset-ai-writing": ["prepare"],
    "@textlint-rule/textlint-rule-no-invalid-control-character": ["prepare"],
    "@textlint-rule/textlint-rule-no-unmatched-pair": ["prepare"],
    "@textlint/regexp-string-matcher": ["prepare"],
    "acorn": ["prepare"],
    "analyze-desumasu-dearu": ["prepare"],
    "balanced-match": ["prepare"],
    "brace-expansion": ["prepare"],
    "eslint-visitor-keys": ["prepare"],
    "eventsource": ["prepare"],
    "express-rate-limit": ["prepare"],
    "glob": ["prepare"],
    "globals": ["prepare"],
    "hashery": ["prepare"],
    "hookified": ["prepare"],
    "keyv": ["prepare"],
    "kuromojin": ["prepare"],
    "lru-cache": ["postprepare", "prepare"],
    "minimatch": ["prepare"],
    "minipass": ["prepare"],
    "package-json-from-dist": ["prepare"],
    "path-scurry": ["prepare"],
    "path-to-regexp": ["prepare"],
    "rc-config-loader": ["prepare"],
    "rimraf": ["prepare"],
    "sentence-splitter": ["prepare"],
    "signal-exit": ["prepare", "preprepare"],
    "textlint-rule-ja-no-mixed-period": ["prepare"],
    "textlint-rule-ja-no-redundant-expression": ["prepare"],
    "textlint-rule-max-ten": ["prepare"],
    "textlint-rule-no-doubled-joshi": ["prepare"],
    "textlint-rule-no-dropping-the-ra": ["prepare"],
    "textlint-rule-no-mix-dearu-desumasu": ["prepare"],
    "textlint-rule-preset-jtf-style": ["prepare"],
    "textlint-rule-prh": ["prepare"],
    "textlint-rule-sentence-length": ["prepare"],
    "textlint-util-to-string": ["prepare"],
    "tinyexec": ["prepare"],
    "ts-api-utils": ["prepare"]
  }
}
